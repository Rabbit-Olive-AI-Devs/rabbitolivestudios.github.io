<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Story book frames (DECISIONS #95). Every 10 minutes (the desk panel's refresh): fetches /desk/castaway and keeps its picture in Dropbox 00_STORYBOOK_SURPRISE_do_not_open/<date>/<HHMM>.png when it is new.
  Install: cp this file ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.eink.storybook.plist
  Run now: launchctl kickstart gui/$(id -u)/com.eink.storybook
  Stop:    launchctl bootout gui/$(id -u)/com.eink.storybook
  Logs:    ~/Library/Logs/eink-series/ (storybook.log, launchd-storybook.log)
  Started through materialize-exec.py like the mailbox jobs (DECISIONS #72): the day's index may be online-only.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.eink.storybook</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/tboliveira/Projetos/rabbitolivestudios.github.io/eink-dashboard/scripts/materialize-exec.py</string>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/tboliveira/Projetos/rabbitolivestudios.github.io/eink-dashboard/scripts/storybook.mjs</string>
    <string>live</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/tboliveira/Projetos/rabbitolivestudios.github.io/eink-dashboard</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/tboliveira/Library/Logs/eink-series/launchd-storybook.log</string>
  <key>StandardErrorPath</key><string>/Users/tboliveira/Library/Logs/eink-series/launchd-storybook.log</string>
</dict>
</plist>
